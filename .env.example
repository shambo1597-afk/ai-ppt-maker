# Copy this file to .env.local (or .env) and fill in the keys you have.
# Every key below is optional — the app degrades gracefully without it.

# Google Gemini API key. Without this, deck generation falls back to the
# local zero-API rule-based engine (src/lib/parser/ruleBasedGenerator.ts).
VITE_GEMINI_API_KEY=

# Pexels API key (https://www.pexels.com/api/), used only by the treated
# stock-photo pipeline (src/lib/assets/stockPhotoFetcher.ts) as a fallback
# source photo for MEDIA_SPLIT-regime slides that have no user-uploaded
# asset. Every photo is background-removed and recolored into the deck's
# own theme before it's ever placed — this key is never used to embed a
# raw, untreated photo. Without this key, the pipeline no-ops silently and
# deck generation behaves exactly as it does today (procedural poster
# graphics only, no fetched images).
VITE_PEXELS_API_KEY=
